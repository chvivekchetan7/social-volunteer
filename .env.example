# SocialVolunteers.in Server Environment Variables

# Backend Port
PORT=5001

# Transactional Email Provider (Option A: Resend)
RESEND_API_KEY=re_123456789_your_real_api_key_here

# Transactional Email Provider (Option B: SMTP / SendGrid / Mailgun)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_smtp_password_here

# Email Sender Address
EMAIL_FROM=SocialVolunteers <verification@socialvolunteers.in>
